# SolveAtlas Environment Configuration

# Canonical Site URL (set to your custom domain upon Vercel deployment)
NEXT_PUBLIC_SITE_URL=https://solveatlas.com

# Google AdSense Monetization
# Set to 'true' to activate live AdSense ads
NEXT_PUBLIC_ADSENSE_ENABLED=false
# Replace with your official Google AdSense Publisher ID (e.g. ca-pub-1234567890123456)
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-0000000000000000

# Google Analytics 4 (GA4)
# Replace with your G-XXXXXXXXXX Measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console Verification
# Meta tag verification string from Google Search Console
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
